# এই ফাইলটা কপি করে .env নাম দিন, তারপর মানগুলো বসান।
# .env কখনো git-এ কমিট করবেন না (পাসওয়ার্ড থাকে)।

# Telegram: @BotFather-এ /newbot দিয়ে পাওয়া bot token
TELEGRAM_TOKEN=
# আপনার chat ID (README-তে কীভাবে বের করবেন লেখা আছে)
TELEGRAM_CHAT_ID=

# শুধু "python workflow.py --loop" মোডে ব্যবহার হয়।
# GitHub Actions / PythonAnywhere scheduled task / cPanel cron নিজেই সময় ঠিক করে,
# তখন এই মান লাগে না।
REPORT_TIME=06:00
TIMEZONE=Asia/Dhaka

# রিপোর্টের "Total" লাইনগুলোতে (per-app লাইনে না, শুধু Total-এ) এই percent-টাই
# দেখানো হবে। যেমন ৪০ দিলে, bdapps থেকে যত টাকাই আসুক, Total-এ তার ৪০% দেখাবে
# (৬০% বাদ)। খালি রাখলে বা ১০০ দিলে কোনো পরিবর্তন হবে না (আসল টাকাই দেখাবে)।
REVENUE_SHARE_PERCENT=40

# bdapps developer portal (user.bdapps.com) অ্যাকাউন্ট।
# NAME না দিলে "account1", "account2"... এমন নাম দেখাবে রিপোর্টে।
# নতুন অ্যাকাউন্ট যোগ করতে ACCOUNT_4_, ACCOUNT_5_ ... দিয়ে একই ৩টা লাইন যোগ করুন,
# কোডে হাত দিতে হবে না।
ACCOUNT_1_NAME=Account 1
ACCOUNT_1_USERNAME=
ACCOUNT_1_PASSWORD=

ACCOUNT_2_NAME=Account 2
ACCOUNT_2_USERNAME=
ACCOUNT_2_PASSWORD=
